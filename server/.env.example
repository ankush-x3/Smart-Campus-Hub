# ─────────────────────────────────────────────
#  Smart Campus Hub — Server Environment
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────
# 1. Go to https://cloud.mongodb.com
# 2. Create a free M0 cluster
# 3. Click "Connect" → "Drivers" → copy the URI
# 4. Replace <username>, <password>, <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_campus_hub?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_64_CHARS
JWT_EXPIRE=30d

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Password Reset Email (SMTP) ────────────────
# Configure on Render to enable password-reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_NAME=Smart Campus Hub
FROM_EMAIL=your_email@gmail.com
CLIENT_URL=https://smart-campus-hub-delta.vercel.app

# ── Cloud Image Storage (Cloudinary - Optional) ─
# Configure on Render for CDN-hosted profile and cover images
# If omitted, images are automatically and permanently stored in MongoDB Atlas
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
