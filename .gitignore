# ─────────────────────────────────────────────
#  Smart Campus Hub — Root .gitignore
# ─────────────────────────────────────────────

# ── Node / npm ────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── Environment variables (NEVER commit these) ─
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build outputs ─────────────────────────────
client/dist/
client/build/

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Coverage ──────────────────────────────────
coverage/
